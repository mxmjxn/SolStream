# {{ ansible_managed }}
# Sunshine config — tuned for low-latency LAN streaming
# Reference: https://docs.lizardbyte.dev/projects/sunshine/

# ----- Web UI / network -----
origin_web_ui_allowed = lan
address_family = both

# ----- Encoder: NVENC, tuned for low-latency -----
encoder = nvenc

# NVENC preset 4 (P4) = balanced quality/latency. P1 costs ~3-5ms extra encode
# per frame which is wasted for streaming where the client's eyes can't tell.
nvenc_preset = {{ solstream_nvenc_preset }}

# Two-pass adds a reference pass before final encode. Off for lowest latency.
nvenc_twopass = {{ solstream_nvenc_twopass }}

# Force NVENC into low-latency tuning
nvenc_h264_cavlc = disabled
nvenc_realtime_hags = {{ solstream_nvenc_realtime_hags }}

# HEVC 10-bit when the client supports it (PC/Shield/Apple TV do)
hevc_mode = {{ solstream_hevc_mode }}

# ----- Pacing / threading -----
min_threads = {{ solstream_min_threads }}

# ----- Logging -----
min_log_level = info

# ----- Audio -----
audio_sink = {{ solstream_audio_sink }}

# ----- Per-stream defaults — LAN-tuned -----
fec_percentage = {{ solstream_fec_percentage }}
