# Sunshine config — tuned for low-latency LAN streaming
# Reference: https://docs.lizardbyte.dev/projects/sunshine/

# ----- Web UI / network -----
origin_web_ui_allowed = lan
address_family = both

# ----- Encoder: NVENC, tuned for low-latency -----
encoder = nvenc

# NVENC preset 4 (P4) = balanced quality/latency for real-time streaming.
# P1 (highest quality) costs ~3-5 ms extra encode time per frame; not worth it
# for streaming where the client's eyes can't tell the difference.
nvenc_preset = 4

# Two-pass adds a reference pass before final encode. Off for lowest latency.
nvenc_twopass = disabled

# Force NVENC into low-latency tuning instead of HQ tuning
nvenc_h264_cavlc = disabled
nvenc_realtime_hags = enabled

# HEVC 10-bit when the client supports it (Moonlight PC/Shield do, Apple TV does)
hevc_mode = 3

# ----- Pacing / threading -----
# 5800X has 16 threads. 4 packetization threads keeps the wire saturated
# without contending with the game/encoder.
min_threads = 4

# ----- Logging -----
min_log_level = info

# ----- Audio -----
audio_sink = Sunshine-Sink

# ----- Per-stream defaults — tuned for 1440p120 LAN -----
# (Moonlight client can still override these per-session)
# fec_percentage is the FEC overhead. Lower = less bandwidth overhead but less
# resilient. On wired LAN we can drop it; revert to default for Wi-Fi clients.
fec_percentage = 10
